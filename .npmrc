# Configuración de npm/bun
# Evita propagar la instalacion de peer deps opcionales que pueden romper builds
optional=false

# Guardar versión exacta (no ^x.y.z) para builds reproducibles
save-exact=false

# Auto-audit desactivado en install para builds más rápidos
audit=false

# Fund message desactivado
fund=false

# Engine strict: fallar si la versión de Node no cumple
engine-strict=true
