# ─────────────────────────────────────────────────────────────────────────────
# .gitattributes — MarcadoresDJ
# Normaliza fin de línea y diff de archivos especiales.
# ─────────────────────────────────────────────────────────────────────────────

# Default: auto-normaliza CRLF <-> LF al checkout/commit
* text=auto eol=lf

# Texto plano con LF forzado
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf
*.html text eol=lf
*.sh text eol=lf
*.env text eol=lf

# Archivos Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: no tocar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.zip binary
*.tar.gz binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# Linguist (GitHub language stats)
# Prisma schema cuenta como código, no como dato
*.prisma linguist-language=Prisma
# Caddyfile no es código
Caddyfile linguist-language=conf

# Ocultar archivos generados de stats
package-lock.json linguist-generated=true
bun.lock linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
