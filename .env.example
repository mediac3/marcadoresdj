# ─────────────────────────────────────────────────────────────────────────────
# .env.example — MarcadoresDJ
# Copia este archivo a `.env` (desarrollo) o `.env.production` (producción)
# y reemplaza los valores con los de tu entorno.
#
#   cp .env.example .env
#
# ⚠️  NUNCA subas el archivo .env real a Git. Ya está excluido en .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Base de datos ───────────────────────────────────────────────────────────
# SQLite local (desarrollo). IMPORTANTE: usa la ruta ABSOLUTA al archivo de la
# base de datos dentro del proyecto. Prisma resuelve las rutas relativas desde
# el directorio del schema (prisma/), por lo que file:./db/custom.db crearía
# prisma/db/custom.db en lugar de <repo>/db/custom.db.
#
# Ejemplo (reemplaza /ruta/absoluta/al/proyecto por tu ruta real):
#   Linux/macOS: file:/home/usuario/proyectos/marcadoresdj/db/custom.db
#   Windows:     file:D:/proyectos/marcadoresdj/db/custom.db
DATABASE_URL="file:/ruta/absoluta/al/proyecto/db/custom.db"

# Ejemplo PostgreSQL (producción):
# DATABASE_URL="postgresql://user:password@localhost:5432/marcadoresdj?schema=public"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Secreto para firmar los tokens JWT de autenticación.
# Usa una cadena aleatoria de al menos 32 caracteres en producción.
# Genera uno con:  openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio-fuerte-de-al-menos-32-caracteres"

# ─── Aplicación ──────────────────────────────────────────────────────────────
# Entorno: development | production
NODE_ENV="development"

# Puerto donde escucha el servidor (production: standalone server)
PORT=3000

# Host al que se binda el servidor (0.0.0.0 para aceptar conexiones externas)
HOSTNAME="0.0.0.0"

# ─── Next.js ─────────────────────────────────────────────────────────────────
# Desactiva la telemetría anónima de Next.js en builds automatizados
NEXT_TELEMETRY_DISABLED=1

# URL pública del sitio (para generar URLs absolutas en emails, sitemap, etc.)
# NEXT_PUBLIC_SITE_URL="https://marcadoresdj.example.com"

# ─── Seed (solo para `bunx prisma db seed`) ─────────────────────────────────
# Credenciales del usuario admin creado por el seed.
# En producción, sobreescribe estos valores con credenciales seguras.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin-password-change-me"
SEED_ADMIN_NAME="Administrador"
